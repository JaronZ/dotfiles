{
    "git.autofetch": true,
    "workbench.iconTheme": "a-file-icon-vscode",
    "files.autoSave": "afterDelay",
    "explorer.autoReveal": true,
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.expand": false,
    "explorer.fileNesting.patterns": {
        "*.ts": "${capture}.js, ${capture}.mjs, ${capture}.ts.map",
        "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
        "*.jsx": "${capture}.js",
        "*.tsx": "${capture}.ts",
        "tsconfig.json": "tsconfig.*.json",
        "tsconfig.base.json": "tsconfig.*.json",
        "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb, bun.lock",
        "vitest.config.ts": "vitest.workspace.ts",
        "README.md": "LICENSE, LICENSE.*",
        ".cliff-jumperrc.yml": "cliff.toml",
        ".zshrc": ".zshrc.pre-oh-my-zsh, .zsh_history, .zprofile, .zshenv, .zlogin",
        ".zcompdump": ".zcompdump-*",
        ".profile": ".profile.bak",
        ".bashrc": ".bash_history, .bash_logout"
    },
    "workbench.startupEditor": "none",
    "workbench.colorTheme": "Xcode Classic (Dark)",
    "github.copilot.enable": {
        "*": true,
        "plaintext": false,
        "markdown": false,
        "scminput": false,
        "cpp": true
    },
    "geminicodeassist.inlineSuggestions.enableAuto": false
}
